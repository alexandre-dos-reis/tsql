{
  "name": "tsql-example-with-postgraphile",
  "private": true,
  "type": "module",
  "scripts": {
    "tsql:check": "tsql check functions/*.ts",
    "tsql:parity": "tsql parity functions/*.ts",
    "tsql:compile": "tsql compile functions/*.ts --out db/01_functions.sql",
    "db": "npm run tsql:compile && docker compose up -d",
    "api": "postgraphile",
    "dev": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@adrdp/tsql": "^0.2.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "pg": "^8.16.0",
    "postgraphile": "^5.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
