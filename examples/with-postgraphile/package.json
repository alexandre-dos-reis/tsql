{
  "name": "tsql-example-with-postgraphile",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsql check functions/*.ts",
    "parity": "tsql parity functions/*.ts",
    "db": "tsql compile functions/*.ts --out db/01_functions.sql && docker compose up -d",
    "api": "postgraphile -P postgraphile/presets/amber -c postgres://postgraphile:secret@localhost:5432/postgres -s api",
    "dev": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@adr/tsql": "^0.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "pg": "^8.16.0",
    "postgraphile": "^5.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
