{
  "name": "@adr/tsql",
  "version": "0.1.0",
  "description": "Compiles a restricted subset of pure TypeScript functions to PL/pgSQL, refusing anything whose semantics it cannot preserve",
  "keywords": [
    "bun",
    "compiler",
    "parity-testing",
    "plpgsql",
    "pure-functions",
    "postgresql",
    "sql",
    "typescript"
  ],
  "homepage": "https://github.com/alexandre-dos-reis/ts-to-plpgsql#readme",
  "bugs": {
    "url": "https://github.com/alexandre-dos-reis/ts-to-plpgsql/issues"
  },
  "license": "MIT",
  "author": "Alexandre Dos Reis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandre-dos-reis/ts-to-plpgsql.git"
  },
  "bin": {
    "tsql": "bin/tsql.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "bin",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pgtypes": "./src/pgtypes.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "bun check --no-script && bun check --no-script -p examples/tsconfig.json",
    "prepublishOnly": "bun run typecheck && bun test",
    "ex:compile": "bun run src/cli.ts compile examples/*.ts --project examples/tsconfig.json --out examples/output.sql --manifest",
    "ex:check": "bun run src/cli.ts check examples/*.ts --project examples/tsconfig.json",
    "ex:parity": "bun run src/cli.ts parity examples/*.ts --project examples/tsconfig.json",
    "changeset": "changeset",
    "version": "changeset version && bun install --lockfile-only",
    "release": "changeset publish"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "commander": "^15.0.0",
    "fast-check": "^4.10.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "1.4.4",
    "oxfmt": "0.74.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
