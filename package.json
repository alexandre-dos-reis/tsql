{
  "name": "@adrdp/tsql",
  "version": "0.2.0",
  "description": "Compiles a restricted subset of TypeScript functions and types to PostgreSQL, refusing anything whose semantics it cannot preserve",
  "keywords": [
    "bun",
    "compiler",
    "parity-testing",
    "plpgsql",
    "postgresql",
    "functions",
    "sql",
    "typescript"
  ],
  "homepage": "https://github.com/alexandre-dos-reis/tsql#readme",
  "bugs": {
    "url": "https://github.com/alexandre-dos-reis/tsql/issues"
  },
  "license": "MIT",
  "author": "Alexandre Dos Reis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandre-dos-reis/tsql.git"
  },
  "bin": {
    "tsql": "bin/tsql.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "bin",
    "dist",
    "src/index.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "bun check --no-script",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run build && bun run typecheck && bun test",
    "changeset": "changeset",
    "version": "changeset version && bun scripts/examples.ts sync && bun install --lockfile-only",
    "release": "changeset publish",
    "ex:link": "bun run scripts/examples link",
    "ex:sync": "bun run scripts/examples sync"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "commander": "^15.0.0",
    "fast-check": "^4.10.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "1.4.4",
    "oxfmt": "0.74.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
